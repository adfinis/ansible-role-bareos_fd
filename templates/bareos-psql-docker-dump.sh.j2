#!/bin/bash
{{ ansible_managed | comment }}
# simple script that runs pg_dump via docker exec and backs up all PostgreSQL databases in the container $CONTAINER_NAME

CONTAINER_NAME="{{ bareos_fd_plugin_psql_docker_container }}"
DB_USER="{{ bareos_fd_plugin_psql_docker_db_user }}"
BACKUP_DIR="{{ bareos_fd_plugin_psql_docker_backup_dir }}"

set -euo pipefail

# create backup directory if it doesn't exist
mkdir -p "$BACKUP_DIR"

echo "Fetching list of databases from container '${CONTAINER_NAME}'..." >&2
DATABASES=$(docker exec -i "$CONTAINER_NAME" psql -U "$DB_USER" -t -c "SELECT datname FROM pg_database WHERE datistemplate = false;" | tr -d '\r')

for DB_NAME in $DATABASES; do
    # skip empty lines generated by psql formatting
    if [ -z "$DB_NAME" ]; then
        continue
    fi

    # use the same file name everytime, so script will overwrite the former backup on the disk
    BACKUP_FILE="${BACKUP_DIR}/${DB_NAME}_backup.dump"

    echo "Starting PostgreSQL backup for database '${DB_NAME}'..." >&2
    docker exec -i "$CONTAINER_NAME" pg_dump -U "$DB_USER" -F c "$DB_NAME" > "$BACKUP_FILE"

    echo "Backup successfully saved to $BACKUP_FILE" >&2
done

echo "All database backups completed successfully." >&2
exit 0
